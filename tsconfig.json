{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["node", "@cloudflare/workers-types"],
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "noEmit": true,
    "allowImportingTsExtensions": true, "esModuleInterop": true
  },
  "include": ["src", "worker", "tests", "*.ts"]
}
